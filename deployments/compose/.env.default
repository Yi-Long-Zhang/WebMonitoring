# The development default for the seeded platform administrator. Published
# account, published password: development only.
#
# This file is the single place the default password lives. The API reads it
# when ADMIN_PASSWORD is unset, so an out-of-the-box stack can still log in;
# production refuses to start on this value and refuses to start without
# ADMIN_PASSWORD at all. Change the default by editing this one file, or point
# ADMIN_PASSWORD_FILE at your own.
#
# It covers ADMIN_PASSWORD only. The other secrets have no file-based fallback --
# the Compose file requires POSTGRES_PASSWORD, S3_ACCESS_KEY, S3_SECRET_KEY and
# BROWSER_WORKER_TOKEN to be supplied outright, and .env.example carries the
# values a development stack starts from.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-production
