module webmonitoring

go 1.27

// The standard library advisories this module is scanned against are fixed
// per patch release, not per minor: 1.27.1 ships eleven reachable ones
// (net/http, net/http/internal/http2, net/textproto, crypto/tls and
// html/template -- the last of which the printable report depends on for
// escaping attacker-controlled text). Pinning the patch here makes every
// developer and CI resolve the same floor without editing the workflow.
toolchain go1.27.2

require (
	github.com/alicebob/miniredis/v2 v2.39.0
	github.com/andybalholm/cascadia v1.3.5
	github.com/jackc/pgx/v5 v5.11.0
	github.com/minio/minio-go/v7 v7.3.0
	github.com/redis/go-redis/v9 v9.23.0
	go.opentelemetry.io/otel v1.47.0
	go.opentelemetry.io/otel/exporters/otlp/otlptrace/otlptracehttp v1.47.0
	go.opentelemetry.io/otel/sdk v1.47.0
	go.opentelemetry.io/otel/trace v1.47.0
	golang.org/x/crypto v0.57.0
	golang.org/x/net v0.60.0
)

require (
	github.com/cenkalti/backoff/v5 v5.0.3 // indirect
	github.com/cespare/xxhash/v2 v2.3.0 // indirect
	github.com/dustin/go-humanize v1.0.1 // indirect
