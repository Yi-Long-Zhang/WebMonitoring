HTTP_ADDR=:8080
APP_BASE_URL=http://localhost:8080
APP_ENV=development
DATA_DIR=.data
SESSION_SECURE=false
ADMIN_USERNAME=admin
# The seeded platform administrator's password. Compose requires it outright, so
# this line must carry a value: the tracked development default is written here
# because a template that left it blank would make `docker compose config` fail
# on the copy you just made. It is the same value as
# deployments/compose/.env.default, and production refuses to start on it.
# Replace it (at least 12 bytes), or set ADMIN_PASSWORD_FILE to a path holding
# your own -- the API falls back to that file only when this variable is unset.
ADMIN_PASSWORD=change-me-before-production
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# Per-tenant request allowance, counted per class and reset each window. A class
# set to 0 is unlimited; production validation refuses that, and refuses a value
# high enough to be indistinguishable from no limit. READ is generous because the
# console polls its dashboard, incident list and event stream on timers. BULK is
# the routes that fan out into per-item work or enqueue jobs -- an asset import,
# a detection trigger, a manual retention run -- so one caller cannot consume a
# worker pool. Leave unset for the built-in defaults (600/120/12 per minute).
# RATE_LIMIT_READ_PER_WINDOW=600
# RATE_LIMIT_WRITE_PER_WINDOW=120
# RATE_LIMIT_BULK_PER_WINDOW=12
# RATE_LIMIT_WINDOW_SECONDS=60
ALLOW_PRIVATE_TARGETS=false
# Cross-origin console. Leave empty when the console and the API share an origin
# (the default single-host Compose topology). List explicit https origins only:
# "*" is refused, because the session cookie cannot be sent to a wildcard origin.
# A non-empty value must use https; production validation enforces both rules.
# ALLOWED_ORIGINS=https://console.example.com
BROWSER_WORKER_URL=http://browser-worker:8081
# Shared secret between the API/http-worker and the browser worker. The Compose
# file requires it explicitly; a production deployment must change this value
# (validation refuses it and enforces a minimum length).
BROWSER_WORKER_TOKEN=replace-with-a-random-token
# Credential-encryption key material. Generate with:
#   openssl rand -base64 32
ALERT_SECRET_KEY=replace-with-base64-encoded-32-byte-key
# Optional key rotation form. When set it takes precedence over ALERT_SECRET_KEY.
# Label every entry; the highest version is used for new writes, and the others
# are kept so existing ciphertext stays readable. Raising ALERT_SECRET_KEYS from
# v1 to v2 makes new values v2 without invalidating anything already stored.
# ALERT_SECRET_KEYS=v1:<base64-32B>,v2:<base64-32B>
QUEUE_MAX_DELIVERIES=5
QUEUE_MIN_IDLE_SECONDS=120
QUEUE_RETRY_BASE_MILLISECONDS=500
ALERT_QUEUE_MAX_DELIVERIES=5
ALERT_QUEUE_MIN_IDLE_SECONDS=120
ALERT_MAX_ATTEMPTS=3
ALERT_RETRY_BASE_MILLISECONDS=250
# Per-channel outbound controls, shared across replicas through Redis. The
# limiter stops one channel being handed the thousand incidents a single bad
# detection run can produce; the breaker stops the retry ladder being spent
# against a webhook that has been dead for an hour. Both fail open: a Redis
# outage must not stop an alert. Setting either to 0 disables that control;
# production refuses 0, because a disabled control is indistinguishable from a
# working one until the day it matters. Cooldown is only meaningful with a
# non-zero threshold.
ALERT_MAX_PER_CHANNEL_PER_WINDOW=60
ALERT_FAILURE_THRESHOLD=5
ALERT_CIRCUIT_COOLDOWN_SECONDS=300
ALERT_GATE_WINDOW_SECONDS=60
# Optional: outbound SMTP relay for EMAIL alert channels. Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# How long a RUNNING detection job may run before a peer replica treats the
# claim as stale and marks it TIMED_OUT. Must exceed 270 (the policy timeout is
# capped at 90s and a browser check spends it twice); production refuses less.
JOB_LEASE_SECONDS=600
EVIDENCE_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
# Background retention pass interval in hours; 0 disables it (manual endpoint only).
RETENTION_INTERVAL_HOURS=24
# Optional OpenTelemetry tracing. Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to keep
# tracing off: spans become no-ops and nothing is exported.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Head sampling ratio for root spans (0.0-1.0). Ignored while tracing is off.
OTEL_TRACES_SAMPLER_ARG=1
# The database password. The Compose file requires it explicitly -- there is no
# default anywhere in the tracked manifests -- and builds every service's
# POSTGRES_DSN from it, so the two must agree. Development value below; a
# production deployment must change it (validation refuses this one and requires
# at least 16 bytes).
POSTGRES_PASSWORD=webmonitoring
# Only read when a service connects with a DSN given directly rather than built
# from POSTGRES_PASSWORD. Keep the two in step if you set this.
POSTGRES_DSN=postgres://webmonitoring:webmonitoring@postgres:5432/webmonitoring?sslmode=disable
# TLS mode for the Postgres connection. Required to be something other than
# disable when APP_ENV=production; the API refuses to start otherwise.
POSTGRES_SSLMODE=disable
# Connection pool bounds, per replica. The defaults are deliberately small: one
# installation runs several API and worker replicas against a single server, so
# the server's max_connections budget is divided among them rather than claimed
# by each. A value of 0 leaves the pool on pgxpool's own default instead of the
# limit you asked for, so production refuses it; the ceiling is 1000 per replica.
# POSTGRES_MAX_CONNS=10
# POSTGRES_MIN_CONNS=1
# POSTGRES_MAX_CONN_LIFETIME_SECONDS=3600
# POSTGRES_MAX_CONN_IDLE_SECONDS=900
# POSTGRES_HEALTH_CHECK_SECONDS=60
# POSTGRES_CONNECT_TIMEOUT_SECONDS=10
# With REDIS_PASSWORD set, carry the same password here:
#   REDIS_ADDR=redis://:your-redis-password@redis:6379
# A production deployment must set it; the API refuses a default or short
# password. The bare host:port form keeps working for development and tests.
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
S3_ENDPOINT=http://minio:9000
# Object-store credentials for the evidence bucket. The Compose file requires
# both explicitly. A production deployment must change the defaults below;
# validation refuses them and enforces a minimum length.
S3_ACCESS_KEY=webmonitoring
S3_SECRET_KEY=replace-with-a-random-secret
S3_BUCKET=evidence
