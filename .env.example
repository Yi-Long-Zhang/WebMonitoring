HTTP_ADDR=:8080
APP_BASE_URL=http://localhost:8080
APP_ENV=development
DATA_DIR=.data
SESSION_SECURE=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-production
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
ALLOW_PRIVATE_TARGETS=false
BROWSER_WORKER_URL=http://browser-worker:8081
BROWSER_WORKER_TOKEN=replace-with-a-random-token
# Credential-encryption key material. Generate with:
#   openssl rand -base64 32
ALERT_SECRET_KEY=replace-with-base64-encoded-32-byte-key
# Optional key rotation form. When set it takes precedence over ALERT_SECRET_KEY.
# Label every entry; the highest version is used for new writes, and the others
# are kept so existing ciphertext stays readable. Raising ALERT_SECRET_KEYS from
# v1 to v2 makes new values v2 without invalidating anything already stored.
# ALERT_SECRET_KEYS=v1:<base64-32B>,v2:<base64-32B>
QUEUE_MAX_DELIVERIES=5
QUEUE_MIN_IDLE_SECONDS=120
QUEUE_RETRY_BASE_MILLISECONDS=500
ALERT_QUEUE_MAX_DELIVERIES=5
ALERT_QUEUE_MIN_IDLE_SECONDS=120
ALERT_MAX_ATTEMPTS=3
ALERT_RETRY_BASE_MILLISECONDS=250
# Optional: outbound SMTP relay for EMAIL alert channels. Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# How long a RUNNING detection job may run before a peer replica treats the
# claim as stale and marks it TIMED_OUT. Must exceed 270 (the policy timeout is
# capped at 90s and a browser check spends it twice); production refuses less.
JOB_LEASE_SECONDS=600
EVIDENCE_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
# Background retention pass interval in hours; 0 disables it (manual endpoint only).
RETENTION_INTERVAL_HOURS=24
# Optional OpenTelemetry tracing. Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to keep
# tracing off: spans become no-ops and nothing is exported.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Head sampling ratio for root spans (0.0-1.0). Ignored while tracing is off.
OTEL_TRACES_SAMPLER_ARG=1
POSTGRES_DSN=postgres://webmonitoring:webmonitoring@postgres:5432/webmonitoring?sslmode=disable
# TLS mode for the Postgres connection. Required to be something other than
# disable when APP_ENV=production; the API refuses to start otherwise.
POSTGRES_SSLMODE=disable
# With REDIS_PASSWORD set, carry the same password here:
#   REDIS_ADDR=redis://:your-redis-password@redis:6379
# A production deployment must set it; the API refuses a default or short
# password. The bare host:port form keeps working for development and tests.
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=webmonitoring
S3_SECRET_KEY=replace-with-a-random-secret
S3_BUCKET=evidence
