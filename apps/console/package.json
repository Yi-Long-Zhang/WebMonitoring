    "vue": "^3.5.20",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.6"
