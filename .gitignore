# Real environment files: deployments/compose/.env beside the manifest (the one
# Compose reads), and any that predate this rule. The templates that must be
# committed are exempted below.
*.env
!.env.example
.data/
.data-*/
.cache/
**/.cache/
dist/
**/dist/
coverage/
node_modules/
**/node_modules/
.pnpm-store/
.pnpm/
.vite/
.vite-temp/
playwright-report/
test-results/
*.log
*.exe

.idea/
.vscode/
.workbuddy/
